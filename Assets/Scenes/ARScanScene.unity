  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "S\u1EF0 NGHI\u1EC6P - \u0110\xD3NG G\xD3P\n\n1400: L\xE0m quan nh\xE0
    H\u1ED3 \n\n1407: B\u1ECB gi\u1EB7c Minh b\u1EAFt giam l\u1ECFng \n\n1417: Tham
    gia kh\u1EDFi ngh\u0129a, d\xE2ng B\xECnh Ng\xF4 s\xE1ch \n\n1428: L\xE0m quan
    tri\u1EC1u L\xEA \n\n1442: \xC1n oan L\u1EC7 Chi Vi\xEAn (tru di tam t\u1ED9c)
    \n\n1464: \u0110\u01B0\u1EE3c gi\u1EA3i oan \n\n<b>Nh\xE0 tham m\u01B0u chi\u1EBFn
    l\u01B0\u1EE3c t\xE0i n\u0103ng </b>\n\n <i>D\xE2ng l\xEAn L\xEA L\u1EE3i B\xECnh
    Ng\xF4 s\xE1ch l\u1EA5y nh\xE2n ngh\u0129a l\xE0m \u0111\u1EA7u. \u0110\u1EC1
    cao chi\u1EBFn l\u01B0\u1EE3c \"T\xE2m c\xF4ng\" - m\u01B0u \u0111\xE1nh v\xE0o
    l\xF2ng ng\u01B0\u1EDDi, kh\xF4ng chi\u1EBFn m\xE0 th\u1EAFng. </i>\n\n<b>B\u1EA3n
    Tuy\xEAn ng\xF4n \u0111\u1ED9c l\u1EADp th\u1EE9 hai </b>\n\n<i> Bi\xEAn so\u1EA1n
    B\xECnh Ng\xF4 \u0111\u1EA1i c\xE1o, \xE1n thi\xEAn c\u1ED5 h\xF9ng v\u0103n
    ca ng\u1EE3i tinh th\u1EA7n \u0111\u1EA1i ngh\u0129a th\u1EAFng hung t\xE0n.
    </i>\n\n<b>\u0110\xF3ng g\xF3p V\u0103n h\xF3a - L\u1ECBch s\u1EED - \u0110\u1ECBa
    l\xFD </b>\n\n<i>\u0110\u1EC3 l\u1EA1i kho t\xE0ng th\u01B0 t\u1ECBch qu\xFD:
    Qu\xE2n trung t\u1EEB m\u1EC7nh t\u1EADp, \u1EE8c Trai thi t\u1EADp, Qu\u1ED1c
    \xE2m thi t\u1EADp, D\u01B0 \u0111\u1ECBa ch\xED... \xD4ng \u0111\xE1nh d\u1EA5u
    b\u01B0\u1EDBc ph\xE1t tri\u1EC3n r\u1EF1c r\u1EE1 c\u1EE7a ch\u1EEF N\xF4m.
    </i>"
